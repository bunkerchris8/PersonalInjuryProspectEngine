# Optional. The Census Data API requires a key; the Census geocoder does not.
CENSUS_API_KEY=

# Optional overrides. Relative paths are resolved from the repository root.
PROSPECT_ENGINE_DATABASE_PATH=data/processed/prospects.db
PROSPECT_ENGINE_MAX_RADIUS_MILES=45

# Optional. Overrides the built-in preview access code without changing app code.
PROSPECT_ENGINE_PREVIEW_UNLOCK_CODE=
